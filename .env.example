# Configure these with `npx convex env set NAME value` on your deployment.
# This file is documentation; Convex functions do not read local .env files.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
SLACK_TEAM_ID=
# Comma-separated Slack member IDs allowed to start or steer runs.
SLACK_ALLOWED_USER_IDS=
CONDUCTOR_API_KEY=
CONDUCTOR_PROJECT_ID=
CONDUCTOR_AGENT=codex
# Choose an accepted model ID from Conductor's current OpenAPI contract.
CONDUCTOR_MODEL=
AUTOMATION_WEBHOOK_SECRET=
# Optional channel for automation-created conversations; bot must be a member.
AUTOMATION_SLACK_CHANNEL=
