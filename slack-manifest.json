{
  "display_information": {
    "name": "Conductor Bot",
    "description": "Coding workspaces and automation conversations",
    "background_color": "#24354b"
  },
  "features": {
    "bot_user": { "display_name": "Conductor", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_DEPLOYMENT.convex.site/slack/events",
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
